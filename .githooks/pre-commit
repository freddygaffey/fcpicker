#!/usr/bin/env bash
set -e

# Skip with `git commit --no-verify` if you really need to.

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

staged="$(git diff --cached --name-only --diff-filter=ACMR)"

# Re-bundle per-board JSON files into frontend/public/boards.json
# whenever any data/boards/*.json is staged.
if echo "$staged" | grep -qE '^data/boards/.*\.json$'; then
  echo "[pre-commit] bundling per-board JSON…"
  python3 tools/bundle.py
  git add frontend/public/boards.json

  # Guardrail: fail the commit if any board would display a physically
  # impossible sensor count (e.g. "15 barometers"). --no-verify to bypass.
  echo "[pre-commit] sanity-checking sensor counts…"
  python3 tools/sanity_check.py
fi

# Lint + build when frontend files (including the freshly-bundled
# boards.json above) are staged.
if git diff --cached --name-only --diff-filter=ACMR | grep -qE '^frontend/'; then
  echo "[pre-commit] running lint…"
  npm run lint --silent

  echo "[pre-commit] running build…"
  npm run build --silent
else
  echo "[pre-commit] no frontend changes; skipping lint/build."
fi
